# Öffentliche URL der Website (z. B. https://cozy-cloud.example)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (öffentliche Werte – Publishable Key ist für den Browser geeignet)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase Secret Key – NUR serverseitig verwenden, niemals ins Frontend geben
SUPABASE_SECRET_KEY=

# Resend (nur serverseitig)
RESEND_API_KEY=
EMAIL_FROM=

# Admin-E-Mail für den geschützten Admin-Bereich
ADMIN_EMAIL=
